[Unit]
Description=KAVACH ATP Knowledge Ingestion (Hourly)
Documentation=https://github.com/DP229/cortex/blob/prototype/scripts/ingest_kavach_cron.sh
Requires=cortex-api.service

[Service]
Type=oneshot
User=cortex
Group=cortex
Environment="ENCRYPTION_KEY=__SET_VIA_SECRET_MANAGER__"
Environment="CORTEX_DOCUMENT_STORAGE=/var/lib/cortex/documents"
Environment="INGEST_MIN_INTERVAL_SECS=3600"
Environment="CORTEX_KAVACH_INGEST_LOG=/var/log/cortex-kavach-ingest.log"
ExecStart=/opt/cortex/scripts/ingest_kavach_cron.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
