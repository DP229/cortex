        <reqif-common:LAST-CHANGE>2026-06-09T20:24:52Z</reqif-common:LAST-CHANGE>
        <reqif-common:DESCRIPTION>The OKU SHALL read RFID balise tags placed at defined trackside positions and update the train's absolute position within 500ms of balise detection. Position error SHALL NOT exceed ±2 metres.</reqif-common:DESCRIPTION>
        <reqif-common:ATTRIBUTES>
          <reqif-common:ATTRIBUTE-VALUE-STRING>
            <reqif-common:ATTRIBUTE-DEFINITION-STRING-REF>ReqIF_CustomRequirementType</reqif-common:ATTRIBUTE-DEFINITION-STRING-REF>
