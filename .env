# Cortex — LOCAL DEVELOPMENT .env
# DO NOT use these values in staging/production.
# Generated for local hands-on testing on Windows.

# === Application ===
APP_NAME=Cortex
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ENABLE_SWAGGER=true

# === Database (SQLite for local dev) ===
# Non-postgresql:// URL triggers the SQLite fallback in cortex/database.py
DATABASE_URL=sqlite:///./cortex.db

# === Security (LOCAL DEV ONLY — regenerate for prod with: python -m cortex.main --generate-keys) ===
# 32-byte base64-encoded key (deterministic placeholder; OK for dev)
ENCRYPTION_KEY=ZGV2LW9ubHktbm90LWZvci1wcm9kdWN0aW9uLTMyYi1rZXk=
JWT_SECRET=dev-only-jwt-secret-please-replace-in-production-environments
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# === Authentication ===
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# === CORS (frontend dev server runs on :3000) ===
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Railway Compliance ===
TOOL_CLASS=T2
DEFAULT_SIL_TARGET=SIL2
DATA_RETENTION_YEARS=10
SAFETY_CASE_OFFICER_EMAIL=safety@local.dev
SAFETY_CASE_OFFICER_PHONE=+1-000-000-0000

# === EN 50716 AI Tool Evidence ===
AI_SYSTEM_VERSION=1.0.0-dev
AI_COMMIT_HASH=local-dev
TRAINING_DATA_HASH=local-dev
DATA_PROVENANCE=internal_curated
PREPROCESSING_VERSION=1.0
MODEL_ARCHITECTURE=transformer
TRAINING_METHODOLOGY=supervised_fine_tuning

# === LLM (Ollama optional — disabled by default for first boot) ===
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# === Embeddings ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_SIZE=10000

# === Storage ===
STORAGE_PATH=./data
WIKI_PATH=./wiki
RAW_PATH=./raw
BACKUP_DIR=./backups
LOG_FILE=./logs/cortex_rail.log
AUDIT_LOG_FILE=./logs/cortex_audit.log

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# === Audit Logging ===
AUDIT_LOG_ENABLED=true
AUDIT_LOG_ACCESS=true

# === T2 Qualification Evidence Output ===
EVIDENCE_OUTPUT_DIR=./.cortex/evidence

# === IBM ELM (DISABLED by default — enable when ready to talk to a live ELM server) ===
ELM_ENABLED=false
# ELM_BASE_URL=https://jazz.example.com/rm
# ELM_OIDC_CLIENT_ID=
# ELM_OIDC_CLIENT_SECRET=
# ELM_OIDC_TOKEN_URL=
# CORTEX_ELM_USER_ID=local-dev-user
